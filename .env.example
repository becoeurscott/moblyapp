# Copy to .env and fill in. Never commit .env — it is gitignored.

# === Runtime ===
NODE_ENV=development
PORT=4000
# Where the API is mounted. Clients call <host><API_PREFIX>/…
API_PREFIX=/api/v1
# Comma-separated allowed origins, or * for any (dev only)
CORS_ORIGINS=*
# Hop count behind a reverse proxy (Render/Railway = 1). Empty = off.
TRUST_PROXY=

# === Database (Supabase) ===
# DATABASE_URL — transaction pooler (port 6543), used at runtime.
# DIRECT_URL   — session pooler (port 5432), used by Prisma migrations.
#                Transaction mode cannot run DDL, which is why the two differ.
#
# Both point at the SAME ...pooler.supabase.com host. Do NOT use the direct
# endpoint db.<project-ref>.supabase.co:5432 here: Supabase serves it over
# IPv6 only unless the project has the paid IPv4 add-on, so any host without
# IPv6 egress (Render's free tier, most CI) fails with Prisma P1001
# "Can't reach database server". The pooler host is IPv4 and works everywhere.
#
# Percent-encode special characters in the password (@ → %40, # → %23…).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# === Auth ===
# Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# === OTP / SMS ===
# In development the OTP code is returned in the API response and logged.
# In production, wire a real SMS provider (Twilio / MTN / Orange) in src/services/otp.ts.
OTP_DEV_MODE=true

# === Cloudinary (image storage + CDN) ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=mobly/listings

# === WhatsApp (share-a-listing only — contact stays in-app) ===
WHATSAPP_MESSAGE_TEMPLATE=Bonjour, j'ai vu votre annonce "{title}" sur Mobly et je suis intéressé.

# === Payments ===
# "stub" auto-settles fake payments so the boost flow is buildable without a PSP.
PAYMENTS_PROVIDER=stub
PAYMENTS_WEBHOOK_SECRET=

# ---- Twilio (SMS OTP delivery) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# --- OR use an API Key instead of the Auth Token (preferred: revocable on its own) ---
# Console > Account > API keys & tokens > Create API key
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Twilio Verify service (starts with VA). Preferred for OTP if configured.
TWILIO_VERIFY_SERVICE_SID=
# Programmable Messaging service (starts with MG). Used only if Verify is empty.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
SMS_ALLOWED_COUNTRIES=237,33,32,1,44,49,41,39,34

# ---- Cron (scheduled tasks) ----
# Shared secret that protects /api/cron/* endpoints. Pass as X-Cron-Secret header.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ---- Apple Push Notifications ----
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY=
APNS_BUNDLE_ID=cm.mobly.app
APNS_PRODUCTION=false

# --- Social sign-in --------------------------------------------------------
# These are the names the LIVE routes read (src/lib/apple.ts, src/lib/google.ts).
# Do not confuse them with APPLE_BUNDLE_IDS / GOOGLE_CLIENT_IDS in
# src/config/env.ts, which feed an unused code path.
APPLE_AUDIENCE=cm.mobly.app
GOOGLE_CLIENT_ID=<ios-oauth-client-id>.apps.googleusercontent.com

# --- Didit (vérification d'identité / badge vérifié) -----------------------
# https://business.didit.me → create an application, then a KYC workflow.
# Server-only: the API key must never be shipped in the iOS app.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
# `secret_shared_key` returned once when the webhook destination is created.
# Without it every webhook is rejected (an unsigned "Approved" = free badge).
DIDIT_WEBHOOK_SECRET=
DIDIT_BASE_URL=https://verification.didit.me
# Where Didit returns the user after the hosted flow. Must match the app's
# URL scheme so the sheet closes back into Mobly.
DIDIT_CALLBACK_URL=moblyapp://kyc/return
