# Mobly release lanes.
#
# Auth: an App Store Connect API key, never an Apple ID password. Create it in
# App Store Connect > Users and Access > Integrations (role: App Manager),
# then save the JSON below OUTSIDE the repo, e.g. ~/.appstoreconnect/mobly.json:
#   { "key_id": "...", "issuer_id": "...", "key_filepath": "/path/AuthKey_XXXX.p8" }
# and point ASC_KEY_JSON at it (defaults to that path).

default_platform(:ios)

ASC_KEY_JSON = ENV.fetch("ASC_KEY_JSON", File.expand_path("~/.appstoreconnect/mobly.json"))

platform :ios do
  private_lane :asc_key do
    app_store_connect_api_key(
      key_id: JSON.parse(File.read(ASC_KEY_JSON))["key_id"],
      issuer_id: JSON.parse(File.read(ASC_KEY_JSON))["issuer_id"],
      key_filepath: JSON.parse(File.read(ASC_KEY_JSON))["key_filepath"]
    )
  end

  desc "Check the API key works: prints the latest TestFlight build number"
  lane :check do
    asc_key
    UI.success("Latest TestFlight build: #{latest_testflight_build_number(app_identifier: 'cm.mobly.app')}")
  end

  desc "Build with a date-time build number and upload to TestFlight"
  lane :beta do
    asc_key
    build_app(
      scheme: "Mobly",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{Time.now.strftime('%Y%m%d%H%M')} -allowProvisioningUpdates"
    )
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Push the store listing (texts, screenshots) without submitting"
  lane :metadata do
    asc_key
    upload_to_app_store(
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      submit_for_review: false,
      run_precheck_before_submit: false
    )
  end

  desc "Attach the latest processed build and submit it for App Review"
  lane :release do
    asc_key
    upload_to_app_store(
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
